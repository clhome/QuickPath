  [执行] shell=pwsh（本地统一用 pwsh；本 workflow 的 run 步骤全部声明为 pwsh）
  ---- 步骤脚本原文（未改写）----
  | $tag = "v1.2.3"
  | # 去掉前导 v，并剥离预发布后缀（与「判定发布通道」步骤同一口径）
  | $tagVersion = ($tag -replace '^v', '') -replace '(?i)(-rc|-alpha|-beta|-pre).*$', ''
  | 
  | if (-not (Test-Path Cargo.toml)) {
  |   Write-Error "未找到 Cargo.toml，无法校验标签版本"
  |   exit 1
  | }
  | $cargoToml = Get-Content Cargo.toml -Raw
  | if ($cargoToml -notmatch '(?m)^version\s*=\s*"([^"]+)"') {
  |   Write-Error "无法从 Cargo.toml 解析 [package] version"
  |   exit 1
  | }
  | $pkgVersion = $Matches[1]
  | 
  | if ($tagVersion -ne $pkgVersion) {
  |   Write-Error "标签版本与 Cargo.toml 不一致：标签 $tag 解析为 $tagVersion，Cargo.toml 为 $pkgVersion"
  |   exit 1
  | }
  | Write-Host "版本一致：标签 $tag，Cargo.toml $pkgVersion"
